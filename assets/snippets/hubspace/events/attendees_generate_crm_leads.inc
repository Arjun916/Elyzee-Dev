<cms:set endpoint = "<cms:get_custom_field 'bitrix_endpoint_url' masterpage='globals.php' />" />
<cms:if endpoint>
<cms:set related_event_name = "<cms:pages masterpage='hubspace/events.php' show_unpublished = '1' show_future_entries='1' page_name=rt_page_name limit='1'><cms:show k_page_title/></cms:pages>"/>

 <cms:php>
	function crm_covert_utf8($s){
		$s = (string)$s;
		$s = html_entity_decode($s, ENT_QUOTES, 'UTF-8');
		if (!mb_detect_encoding($s, 'UTF-8', true)) {
			$s = mb_convert_encoding($s, 'UTF-8', 'auto');
		}
		$s = iconv('UTF-8', 'UTF-8//IGNORE', $s);
		return $s;
	}
 </cms:php>



<cms:pages masterpage="hubspace/attendees.php" show_future_entries='1' page_name="NOT default-page-for-hubspace-attendees-php" custom_field="related_event=<cms:show rt_page_name/>" base_link="<cms:route_link masterpage='hubspace/events.php' 'crm_update' rt_page_name=rt_page_name/>" paginate='1' limit='1'>

<cms:if k_paginated_top >
            
	<cms:if k_paginate_link_next >
		<script language="JavaScript" type="text/javascript">
			var crm_update_timeout = window.setTimeout( 'location.href="<cms:show k_paginate_link_next />";', 1000 );
			
			 function stopCRMProcess() {
				clearTimeout(crm_update_timeout);
				window.setTimeout(function () {
					location.href = "<cms:route_link masterpage='hubspace/events.php' 'crm_update' rt_page_name=rt_page_name/>";
				}, 1000);
			}
  
		</script>
		<div class="alert alert-warning">
			<h5>CRM update in progress!</h5>
			<p>Please do not refresh or close this page. Keep it open until the process is complete.</p>
			<button class="btn btn-danger" onclick="stopCRMProcess();">Stop the process</button>
		</div>
		<cms:set_flash name='success_msg' value='2' />
		<cms:set_flash name='message_value' value="<b>You have stopped the process midway.</b><br>The CRM sync has been partially completed. Some leads may not have been pushed. You can resume the process at any time." />
	</cms:if>
	
	<div class="alert alert-info">
		
		<h6 class="border-bottom">In Progress: <cms:show k_current_page /> / <cms:show k_total_pages /> leads generated in CRM.</h6>
		<div class="progress">
			<cms:set display_current = "<cms:add k_current_page '1' />" />
			<cms:set progress_percent="<cms:mul display_current '100' />" />
			<cms:set progress_percent="<cms:div progress_percent k_total_pages />" />

			<div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
			role="progressbar"
			aria-valuenow="<cms:show display_current />"
			aria-valuemin="1"
			aria-valuemax="<cms:show k_total_pages />"
			style="width: <cms:show progress_percent />%">
			<cms:number_format progress_percent decimal_precision='0'/>%
			</div>
		</div>
	 </div>
	
	   <table class="table table-responsive">
		<thead>
			<tr>
			<th>No.</th>
			<th>Attendee</th>
			<th>Status: Lead ID</th> 
			</tr>
		</thead>
		<tbody>
 </cms:if>					
	<tr>
	<td><cms:show k_current_record /></td>
	<td><cms:show attendee_name /></td>
	<td>

  <cms:php>
	global $CTX;
	$endpoint = trim("<cms:show endpoint/>");
  
	$name  = crm_covert_utf8(trim("<cms:show attendee_name/>"));
	$email = trim("<cms:show attendee_email/>");
	$phone = trim("<cms:show attendee_phone/>");

	$gender  = crm_covert_utf8(trim("<cms:show attendee_gender/>"));
	$designation  = crm_covert_utf8(trim("<cms:show attendee_designation/>"));
	$speciality  = crm_covert_utf8(trim("<cms:show speciality/>"));
	$doctors  = crm_covert_utf8(trim("<cms:show doctors/>"));
	$note  = crm_covert_utf8(trim("<cms:show note/>"));

	$nationality = crm_covert_utf8(trim("<cms:show attendee_nationality/>"));
	$city = crm_covert_utf8(trim("<cms:show attendee_city/>"));
	$language = crm_covert_utf8(trim("<cms:show attendee_language/>"));
	$existing = crm_covert_utf8(trim("<cms:show attendee_existing/>"));
	$related_event = crm_covert_utf8(trim("<cms:show related_event_name/>"));
	$page_date = crm_covert_utf8(trim("<cms:show page_date/>"));
  
	$owner_name = crm_covert_utf8(trim("<cms:show owner_name/>"));
	$crm_owner_name = crm_covert_utf8(trim("<cms:show k_user_title/>"));
  
	$title = crm_covert_utf8(trim("[Events] - <cms:show attendee_name/>"));	


	$crm_comments = "<b>Gender:</b> {$gender}\n<b>Existing Elyzee Patient:</b> {$existing}\n<b>Preferred Language:</b> {$language}\n<b>Preferred Speciality:</b> {$speciality}\n<b>Preferred Doctors:</b> {$doctors}\n<b>Note:</b><br>{$note}\n\n<b>Nationality:</b> {$nationality}\n<b>City:</b> {$city}\n\n<b>Lead Captured Event:</b> {$related_event}\n<b>Lead Captured Date:</b> {$page_date}\n<b>CRM Lead Generated by:</b> {$crm_owner_name}\n<b>Lead Captured By:</b> {$owner_name}\n";
	
	$comments = crm_covert_utf8(trim($crm_comments));
	
	
	$params = [
	'FIELDS[TITLE]' => $title,
	'FIELDS[NAME]'  => $name,
	'FIELDS[EMAIL][0][VALUE]'      => $email,
	'FIELDS[EMAIL][0][VALUE_TYPE]' => 'WORK',
	'FIELDS[PHONE][0][VALUE]'      => $phone,
	'FIELDS[PHONE][0][VALUE_TYPE]' => 'MOBILE',
	'FIELDS[SOURCE_ID]' => 'UC_I00Y8G',
	'FIELDS[COMMENTS]'  => $comments,
	'FIELDS[SOURCE_DESCRIPTION]' => $related_event,
	'FIELDS[UTM_SOURCE]'         => $related_event,
	];


	if ($email === '') {unset($params['FIELDS[EMAIL][0][VALUE]'], $params['FIELDS[EMAIL][0][VALUE_TYPE]']);}
	if ($phone === '') {unset($params['FIELDS[PHONE][0][VALUE]'], $params['FIELDS[PHONE][0][VALUE_TYPE]']);}

	$ch = curl_init($endpoint);
	curl_setopt_array($ch, [
		CURLOPT_RETURNTRANSFER => true,
		CURLOPT_POST           => true,
		CURLOPT_POSTFIELDS     => $params,
		CURLOPT_HTTPHEADER     => ['Accept: application/json'],
		CURLOPT_TIMEOUT        => 20,
		CURLOPT_SSL_VERIFYPEER => true,
		CURLOPT_FOLLOWLOCATION => true,
	]);

	$response = curl_exec($ch);
	$curlErr  = curl_error($ch);
	$httpCode = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
	curl_close($ch);

	$leadId = '';
	$crmError = '';
	$crmErrorDesc = '';

	if ($curlErr) {
		$crmError = 'CURL_ERROR';
		$crmErrorDesc = $curlErr;
	} else {
		$json = json_decode((string)$response, true);

		if (is_array($json) && isset($json['result'])) {
			$leadId = (string)$json['result'];
		} elseif (is_array($json) && isset($json['error'])) {
			$crmError = (string)$json['error'];
			$crmErrorDesc = (string)($json['error_description'] ?? '');
		} else {
			$crmError = 'UNKNOWN_RESPONSE';
			$crmErrorDesc = (string)$response;
		}
	}
	$CTX->set('crm_lead_id_val', $leadId, 'global');
	$CTX->set('crm_error_val', $crmError, 'global');
	$CTX->set('crm_error_desc_val', $crmErrorDesc, 'global');
	$CTX->set('crm_raw_response_val', $response, 'global');
	</cms:php>

<cms:if k_page_id && k_page_id gt '0'>
	<cms:set update_k_publish_date = "<cms:if crm_lead_id_val>0000-00-00 00:00:00<cms:else/><cms:date k_publish_date format='Y-m-d H:i:s'/></cms:if>"/>
	<cms:db_persist
    _invalidate_cache='0'
    _masterpage='hubspace/attendees.php'
    _mode='edit'
	_page_id = k_page_id
	crm_lead_id = crm_lead_id_val
	crm_raw_response = crm_raw_response_val
	crm_error = crm_error_val
	crm_error_desc = crm_error_desc_val
	crm_owner_name = "<cms:if crm_lead_id_val><cms:show k_user_title/></cms:if>"
	crm_synced_on="<cms:if crm_lead_id_val><cms:date format='Y-m-d H:i:s' /></cms:if>"
	k_publish_date=update_k_publish_date
>  

    <cms:if k_error >
        Error: <cms:each k_error ><cms:show item />, </cms:each>
	<cms:else />Success: <cms:show crm_lead_id_val/>
	</cms:if>
</cms:db_persist>

</cms:if>

</td>
 </tr>

<cms:if k_paginated_bottom > 
		</tbody>
		
		<tfoot><tr><td colspan='3' class="text-muted"><cms:ignore><cms:paginator simple='1' /></cms:ignore>CRM Update in progress!</td></tr></tfoot>
	</table>  
	
	<cms:if k_paginate_link_next >
