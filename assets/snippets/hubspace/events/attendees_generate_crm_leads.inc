		<cms:set_flash name='message_value' value="<h6 class='text-light'>CRM sync attempt complete!</h6>All leads have been processed. Review each attentee info to confirm the CRM update and Lead ID Status. <b>Failed leads, if any, can be retried after some time.</b>" />
		<cms:redirect url="<cms:route_link masterpage='hubspace/events.php' 'page_view' rt_page_name=rt_page_name rt_format='.html'/>"/>
	</cms:if>
</cms:if>
			
</cms:pages>
<cms:else/>
	<div class="alert alert-warning">
	<h5>CRM endpoint is not configure in the CMS!</h5>
	Kindly coordinate with the IT team to fix it and try again.
	</div>
</cms:if>