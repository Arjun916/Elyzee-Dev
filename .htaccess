Options +SymLinksIfOwnerMatch -MultiViews
<IfModule mod_rewrite.c>
RewriteEngine On

#If your website is installed in a subfolder, change the line below to reflect the path to the subfolder.
#e.g. for http://www.example.com/subdomain1/subdomain2/ make it RewriteBase /subdomain1/subdomain2
RewriteBase /

#If you wish to use a custom 404 page, place a file named 404.php in your website's root and uncomment the line below.
#If your website is installed in a subfolder, change the line below to reflect the path to the subfolder.
#e.g. for http://www.example.com/subdomain1/subdomain2/ make it ErrorDocument 404 /subdomain1/subdomain2/404.php
ErrorDocument 404 /404.php

#If your site begins with 'www', uncomment the following two lines
RewriteCond %{HTTP_HOST} !^www\.
RewriteRule ^(.*)$ http://www.%{HTTP_HOST}/$1 [R=301,L]

RewriteRule ^(?:en|ar)$ "$0/" [R=301,L,QSA]
RewriteRule ^(en|ar)/$ index.php?lc=$1 [L,QSA]


#DO NOT EDIT BELOW THIS


RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule . - [L]

#globals.php
RewriteRule ^(?:en|ar)/globals$ "$0/" [R=301,L,QSA]
RewriteRule ^(en|ar)/globals/$ globals.php?lc=$1 [L,QSA]
RewriteRule ^(en|ar)/globals/.*?([^\.\/]*)\.html$ globals.php?pname=$2&lc=$1 [L,QSA]
RewriteRule ^(en|ar)/globals/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ globals.php?d=$2$3$4&lc=$1 [L,QSA]
RewriteRule ^(en|ar)/globals/[^\.]*?([^/\.]*)/$ globals.php?fname=$2&lc=$1 [L,QSA]
RewriteRule ^(?:en|ar)/globals/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

#seo.php
RewriteRule ^seo$ "$0/" [R=301,L,QSA]
RewriteRule ^seo/$ seo.php [L,QSA]
RewriteRule ^seo/.*?([^\.\/]*)\.html$ seo.php?pname=$1 [L,QSA]
RewriteRule ^seo/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ seo.php?d=$1$2$3 [L,QSA]
RewriteRule ^seo/[^\.]*?([^/\.]*)/$ seo.php?fname=$1 [L,QSA]
RewriteRule ^seo/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

