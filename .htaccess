RewriteRule ^hubspace/events/$ hubspace/events.php [L,QSA]
RewriteRule ^hubspace/events/(.+?)$ hubspace/events.php?q=$1 [L,QSA]


#hubspace/index.php
RewriteRule ^hubspace/index.php$ "hubspace/" [R=301,L,QSA]
RewriteRule ^hubspace/.*?([^\.\/]*)\.html$ hubspace/?pname=$1 [L,QSA]
RewriteRule ^hubspace/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ hubspace/?d=$1$2$3 [L,QSA]
RewriteRule ^hubspace/[^\.]*?([^/\.]*)/$ hubspace/?fname=$1 [L,QSA]
RewriteRule ^hubspace/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]


</IfModule>
