RewriteRule ^(en|ar)/executive-team/.*?([^\.\/]*)\.html$ executive-team.php?pname=$2&lc=$1 [L,QSA]
RewriteRule ^(en|ar)/executive-team/([1-2]\d{3})/(?:(0[1-9]|1[0-2])/(?:(0[1-9]|1[0-9]|2[0-9]|3[0-1])/)?)?$ executive-team.php?d=$2$3$4&lc=$1 [L,QSA]
RewriteRule ^(en|ar)/executive-team/[^\.]*?([^/\.]*)/$ executive-team.php?fname=$2&lc=$1 [L,QSA]
RewriteRule ^(?:en|ar)/executive-team/[^\.]*?([^/\.]*)$ "$0/" [R=301,L,QSA]

